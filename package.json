{
  "name": "astar-minimal",
  "version": "1.0.0",
  "description": "A minimal, dependency-free A* search over an arbitrary graph, plus the binary heap it builds on.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpsirois/astar-minimal.git"
  },
  "homepage": "https://github.com/rpsirois/astar-minimal#readme",
  "bugs": {
    "url": "https://github.com/rpsirois/astar-minimal/issues"
  },
  "keywords": [
    "astar",
    "a-star",
    "pathfinding",
    "graph",
    "search",
    "heap",
    "priority-queue"
  ],
  "main": "./esm/index.js",
  "exports": "./esm/index.js",
  "files": [
    "esm/index.js",
    "esm/index.js.map"
  ],
  "devDependencies": {
    "rollup": "^2.79.0",
    "rollup-plugin-jsy": "^1.7.5"
  },
  "scripts": {
    "clean": "rm -rf ./esm/*",
    "prebuild": "test -d ./node_modules || npm ci",
    "build": "rollup --config",
    "watch": "rollup --config --watch",
    "pretest": "npm -s run build",
    "test": "node ./esm/test_astar.js && node ./esm/test_astar_edges.js",
    "prepublishOnly": "npm test"
  }
}
